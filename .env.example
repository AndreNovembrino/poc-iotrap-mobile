# Copie para .env.local (que não vai para o Git) e ajuste.
# Endereço do Elasticsearch do IoTrap, ou do mock (npm run mock mostra o IP certo).
# Use o IP da sua máquina na rede, não "localhost": o celular é outro aparelho.
EXPO_PUBLIC_IOTRAP_ES_URL=http://192.168.0.10:9200
EXPO_PUBLIC_IOTRAP_INDEX=cowrie-*
# Chave de API SOMENTE LEITURA, restrita ao índice do Cowrie.
# Tudo que começa com EXPO_PUBLIC_ vai embutido no app: não é segredo.
EXPO_PUBLIC_IOTRAP_API_KEY=
